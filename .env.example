NODE_ENV=development

POSTGRES_PORT=5432
# Lokal: Docker Compose; Development/Preview: Neon; Production/Staging: Railway.
DATABASE_URL=postgresql://darts:darts@localhost:5432/darts
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Optional, comma-separated list of further explicitly trusted browser origins.
WEB_ADDITIONAL_ORIGINS=
LOG_LEVEL=log

# Rate Limits je IP-Adresse und Minute. Die Vorgaben greifen auch ohne
# Eintrag; für E2E-Läufe setzt playwright.config.ts eigene Werte.
RATE_LIMIT_MAX_PER_MINUTE=300
RATE_LIMIT_PUBLIC_MAX_PER_MINUTE=600
# Better Auths eigener Limiter ist lokal aktiv; für interaktive Entwicklung
# mit häufigen Anmeldungen z. B. auf 1000 setzen.
RATE_LIMIT_SENSITIVE_MAX_PER_MINUTE=10
# Socket.IO-Handshakes je Client-Adresse und Minute; der Endpunkt haengt am
# HTTP-Server und laeuft nicht durch das Fastify-Limit.
RATE_LIMIT_SOCKET_MAX_PER_MINUTE=60

# Erlaubt "Organisation erstellen" in der Oberfläche. Vorgabe false:
# Mandanten entstehen über pnpm db:bootstrap:production (ADR 0012).
# Für lokale Entwicklung mit dem Formular auf true setzen.
ALLOW_SELF_SERVICE_ORGANIZATIONS=false

# Anzahl vertrauter Reverse-Proxy-Hops: 0 lokal (kein Proxy), 1 hinter
# Railway. Bestimmt, welcher X-Forwarded-For-Eintrag als Client-Adresse
# gilt; zu hoch gesetzt wird die Adresse durch den Client selbst faelschbar.
# In Produktion Pflicht (siehe infrastructure/railway.md) – der Deploy
# scheitert sonst beim Start.
TRUST_PROXY_HOPS=0

# Diagnose-Flag fuer die Untersuchung des Rate-Limit-Schluessels (Plan
# 2026-09-17-go-live-testprogramm, Task 3): schreibt request.ip und die
# rohen Adress-Header ins Request-Log. Vorgabe false.
LOG_CLIENT_ADDRESS=false

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
