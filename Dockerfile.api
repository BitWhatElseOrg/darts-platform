FROM node:24-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN corepack enable

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build:api

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable

COPY --from=build --chown=node:node /app /app

USER node

# PORT wird von .railway/railway.ts auf 8080 gesetzt, damit die als String
# deklarierte Domain (fest auf Zielport 8080 im SDK) zum tatsächlichen
# Listen-Port passt. EXPOSE ist rein dokumentativ und erzwingt keinen
# Bind-Port, hält ihn hier aber konsistent zur Konfiguration.
EXPOSE 8080

CMD ["node", "scripts/start-api.mjs"]
