{
  "name": "darts-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "dotenv -e .env -v NODE_ENV=production -- turbo run build",
    "build:api": "turbo run build --filter=@darts-platform/api...",
    "build:web": "turbo run build --filter=@darts-platform/web...",
    "build:worker": "turbo run build --filter=@darts-platform/worker...",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "dotenv -e .env -- turbo run test",
    "test:e2e": "turbo run build --filter=@darts-platform/config --filter=@darts-platform/database --filter=@darts-platform/domain --filter=@darts-platform/scoring-engine --filter=@darts-platform/statistics --filter=@darts-platform/schemas --filter=@darts-platform/ui && dotenv -e .env -- pnpm --filter @darts-platform/web test:e2e",
    "db:generate": "dotenv -e .env -- pnpm --filter @darts-platform/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @darts-platform/database db:migrate",
    "start:api:deploy": "node scripts/start-api.mjs",
    "start:web:deploy": "pnpm --filter @darts-platform/web start",
    "start:worker:deploy": "pnpm --filter @darts-platform/worker start",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "globals": "^16.5.0",
    "railway": "^3.11.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
