{
  "name": "@darts-platform/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port ${WEB_PORT:-3000}",
    "build": "next build --webpack",
    "start": "next start --port ${WEB_PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:coverage": "vitest run --dir src --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts"
  },
  "dependencies": {
    "@darts-platform/config": "workspace:*",
    "@darts-platform/domain": "workspace:*",
    "@darts-platform/league-engine": "workspace:*",
    "@darts-platform/schemas": "workspace:*",
    "@darts-platform/scoring-engine": "workspace:*",
    "@darts-platform/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "1.7.1",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.65.0",
    "socket.io-client": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@darts-platform/database": "workspace:*",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-orm": "0.45.2",
    "happy-dom": "^20.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
